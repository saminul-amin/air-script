# Copy to .env (or export in your shell). Everything here is optional.

# Path to the trained weights. Default: saved_model/emnist_cnn.pth (committed).
# AIRSCRIPT_MODEL_PATH=

# If the weights file is absent, download it from this URL once at startup
# (for example a Hugging Face model file or a GitHub Release asset).
# AIRSCRIPT_MODEL_URL=

# Expected SHA-256 of the weights. Default: read from saved_model/emnist_cnn.sha256.
# AIRSCRIPT_MODEL_SHA256=

# Comma-separated browser origins allowed by CORS. Default: * (any origin).
# AIRSCRIPT_CORS_ORIGINS=http://localhost:3000,https://airscript-frontend.vercel.app

# Start even if weights are missing: text endpoints work, /predict returns 503.
# Never set this in production.
# AIRSCRIPT_ALLOW_MISSING_MODEL=1
