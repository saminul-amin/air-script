# Where the browser sends API calls (correction, suggestions, the personal
# dictionary, and the server-side recognition fallback). Copy to .env.local to override.
#
# Default (unset): "/api" — the Express gateway. In `npm run dev` Vite proxies
# /api to http://localhost:5000; in production you would put the gateway behind
# the same origin or set this to its public URL, e.g. https://my-gateway.example.com/api
#
# To talk straight to a deployed FastAPI service (e.g. a Hugging Face Space),
# set the service origin with no /api suffix:
# VITE_API_BASE_URL=https://saminul-amin-airscript-backend.hf.space
VITE_API_BASE_URL=

# On-device recognition (ONNX Runtime Web). Characters are recognised in the
# browser by default; the server is only used if that fails to load.
#   VITE_LOCAL_MODEL=int8    the 1.7 MB dynamically quantised export (default)
#   VITE_LOCAL_MODEL=fp32    the 6.8 MB float export
#   VITE_RECOGNITION=server  never recognise on the device (also: ?recognition=server in the URL)
VITE_LOCAL_MODEL=
VITE_RECOGNITION=
