{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ai-service",
      "cwd": "ai-service",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "server",
      "cwd": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5000
    },
    {
      "name": "client",
      "cwd": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    }
  ]
}
